+internal sealed partial class CombatBeamSolver
+{
+    internal bool DisableForcedRoundHpBoundForTesting { get; init; }
+    internal bool DisableParallelForcedRoundHpForTesting { get; init; }
+    private int _forcedRoundParallelWaves, _forcedRoundParallelNodes;
+    // A worker inherits this token once before publication; separate solves keep separate tokens.
+    private object _forcedRoundOwner = new();
+    private int _forcedRoundHpProbes, _forcedRoundHpPruned, _forcedRoundHpSaved, _forcedRoundHpReuses;
+    internal int ForcedRoundHpSavedForTesting => _forcedRoundHpSaved;
+    internal int ForcedRoundHpReusesForTesting => _forcedRoundHpReuses;
+    private sealed class ForcedRoundPrefixCapture { public bool TakingExtraTurn { get; set; } }
+    private int _forcedRejectedBoundary, _forcedRejectedRisk, _forcedRejectedChoice, _forcedEnded, _forcedUnknownHealing, _forcedNotWorse;
+    internal int ForcedRoundHpProbesForTesting => _forcedRoundHpProbes;
+    internal int ForcedRoundHpPrunedForTesting => _forcedRoundHpPruned;
+    private bool CanProbeForcedRoundHp(SearchNode node, out CombatPredictionSimulator source,
+        out SimulatedCombatState combat)
+    {
+        source = null!; combat = null!;
+        if (DisableForcedRoundHpBoundForTesting || !CanUseZeroCreditForcedRoundPolicy()
+            || node.IsTerminal || node.Snapshot.HasRisk || !node.Snapshot.HasSimulator
+            || node.BoundaryReason != SearchBoundaryReason.None
+            || !(_forceAllPotionsDisabled || _potionPolicy == SolverPotionPolicy.Disabled
+                || _maximumPotionUses is { } maximum && ExplicitPotionUseCount(node) >= maximum)) return false;
+        source = (CombatPredictionSimulator)node.Snapshot.Simulator;
+        combat = (SimulatedCombatState)source.State.CombatState;
+        var playerState = source.State.GetPlayerCombatState(_player);
+        if (source.HasPendingChoice || !source.IsInProgress || playerState.OrbQueue.Orbs.Count != 0
+            || combat.Allies.Any(ally => ally.Player is null)) return false;
+        if (playerState.Phase != PlayerTurnPhase.Play) return false;
+        foreach (var card in playerState.Hand.Cards)
+            if (combat.CanPlayCard(source, card)) return false;
+        return true;
+    }
+    private bool CanUseZeroCreditForcedRoundPolicy()
+        => root.CanCertifyRemainingHealing && policy.EffectiveGrowthBudgets == default
+            && !policy.EffectiveHasGrowthTargets && policy.RelicTargets.Count == 0
+            && _theftPolicy != SolverTheftPolicy.PreserveResources
+            && !_potionStrategy.HasForcedDirectives && _minimumPotionUses == 0
+            && _potionPolicy is SolverPotionPolicy.Disabled or SolverPotionPolicy.Smart;
+
+    private List<SearchNode> ApplyZeroCreditForcedRoundHpBound(List<SearchNode> retained)
+    {
+        if (DisableForcedRoundHpBoundForTesting || !CanUseZeroCreditForcedRoundPolicy()
+            || !_primaryIncumbents.TryGet(new PrimaryIncumbentBucket(0, 0), out var witness))
+            return retained;
+        if (!DisableParallelForcedRoundHpForTesting && _run.ActiveParallelExpansion is { } executor
+            && retained.Count >= 2)
+            return ApplyParallelForcedRoundHpBound(retained, witness.StrategicHpDeficit, executor);
+        List<SearchNode>? bounded = null;
+        for (int index = 0; index < retained.Count; index++)
+        {
+            SearchNode node = retained[index];
+            if (!ShouldPruneForcedRoundHp(node, witness.StrategicHpDeficit))
+            { bounded?.Add(node); continue; }
+            bounded ??= retained.GetRange(0, index);
+            _run.PrimaryIncumbentBranchesPruned++;
+        }
+        return bounded ?? retained;
+    }
+
+    private bool ShouldPruneForcedRoundHp(SearchNode node, int maximumStrategicHpDeficit)
+    {
+        if (!CanProbeForcedRoundHp(node, out var source, out var combat)) return false;
+        cancellationToken.ThrowIfCancellationRequested();
+        _forcedRoundHpProbes++;
+        _run.ForkCount++;
+        var probe = source.Fork();
+        var prefix = new ForcedRoundPrefixCapture();
+        var probeCombat = (SimulatedCombatState)probe.State.CombatState;
+        var processed = ((ForkableSet<uint>)node.Snapshot.ProcessedEnemyDeaths).Fork();
+        int shuffles = node.Snapshot.ShufflesCrossed;
+        SearchBoundaryReason boundary;
+        using (probe.BeginExecutionDispatch())
+            boundary = AdvanceRound(probe, probeCombat, node.Turn - _startTurnNumber,
+                processed, ref shuffles, null, stopBeforePlayerStartForBound: true, forcedPrefixCapture: prefix);
+        if (boundary != SearchBoundaryReason.None) { _forcedRejectedBoundary++; return false; }
+        if (GetCoverageSummary(probe).HasUncompensatedRisk) { _forcedRejectedRisk++; return false; }
+        if (probe.HasPendingChoice) { _forcedRejectedChoice++; return false; }
+        if (!probe.IsInProgress || probeCombat.DeathSaveUseCount != 0) { _forcedEnded++; return false; }
+        var player = probe.State.GetCreature(_player.Creature);
+        int healing = StrategicHpRecoveryBound.ComponentHealingUpperBound(probe, _player,
+            root.PostCombatRelicHeal.UnconditionalHeal + root.PostCombatRelicHeal.WoundedHeal,
+            includePotionHealing: !_forceAllPotionsDisabled, maximumExplicitPotionUses: _maximumPotionUses,
+            potionStrategy: _potionStrategy, effectivePotionPolicy: _potionPolicy);
+        if (healing == int.MaxValue) { _forcedUnknownHealing++; return false; }
+        int lower = ActEndingBossPolicy.StrategicHpDeficit(
+            probeCombat.GetCumulativeHpLost(_player.Creature), maxHpDeficit: 0,
+            StrategicHpRecoveryBound.OptimisticRecoveredHp(probeCombat.GetRecoveredHp(_player.Creature),
+                player.CurrentHp, player.MaxHp, healing), _strategicBossHpRelief,
+            probeCombat.DeathSaveRelicHpRestored + probeCombat.DeathSavePotionHpRestored);
+        if (lower <= maximumStrategicHpDeficit)
+        {
+            _forcedNotWorse++;
+            CompleteAndSaveForcedRound(node, probe, probeCombat, processed, shuffles, prefix.TakingExtraTurn);
+            return false;
+        }
+        _forcedRoundHpPruned++;
+        return true;
+    }
+    private void CompleteAndSaveForcedRound(SearchNode node, CombatPredictionSimulator probe,
+        SimulatedCombatState combat, ForkableSet<uint> deaths, int shuffles, bool takingExtraTurn)
+    {
+        cancellationToken.ThrowIfCancellationRequested();
+        var cursor = new TurnStartChoiceCursor(null);
+        combat.BeginActionChoices(cursor);
+        SearchBoundaryReason boundary;
+        try
+        {
+            using var dispatch = probe.BeginExecutionDispatch();
+            boundary = AdvanceRoundPlayerStart(probe, combat, probe.State.GetPlayerCombatState(_player),
+                probe.State.GetCreature(_player.Creature), node.Turn - _startTurnNumber, deaths,
+                ref shuffles, cursor, takingExtraTurn);
+        }
+        finally { combat.EndActionChoices(); }
+        _ = combat.ConsumePlayerTurnEndRequest();
+        if (boundary == SearchBoundaryReason.None && !SettleReplayActionBoundary(probe, combat))
+            boundary = SearchBoundaryReason.PendingChoice;
+        var completed = Snapshot(probe, combat.GetPlayerTurnNumber(_player), node.ActionCount + 1,
+            shuffles, boundary, deaths);
+        node.Snapshot.SavePrecomputedEndTurn(_forcedRoundOwner, node.Turn, node.ActionCount, completed);
+        _forcedRoundHpSaved++;
+    }
+
+    internal bool CanProbeForcedRoundForTesting(SearchNode node) => CanProbeForcedRoundHp(node, out _, out _);
+    internal SearchNode ForcedRoundRootForTesting() => CreateOpeningSearchSeed(Replay([]));
+    internal PlanAction ForcedRoundCardForTesting(SearchNode node, string id)
+        => PrepareCardActions(node).First(prepared => prepared.Action.CardId == id).Action;
