+using System.Diagnostics;
+using CombatSolver.Engine.Common;
+using System.Runtime.ExceptionServices;
+
+namespace CombatSolver;
+
+internal sealed partial class CombatBeamSolver
+{
+    private List<SearchNode> ApplyParallelForcedRoundHpBound(List<SearchNode> retained,
+        int maximumStrategicHpDeficit, ParallelExpansionExecutor executor, bool smartEligibility = false)
+    {
+        bool[] prune = new bool[retained.Count];
+        List<SearchNode> pending = [];
+        List<int> indices = [];
+        HashSet<CombatSolver.Engine.InCombat.Simulation.CombatPredictionSimulator> seen = new(ReferenceEqualityComparer.Instance);
+        bool unique = true;
+        for (int index = 0; index < retained.Count; index++)
+        {
+            SearchNode node = retained[index];
+            if (CanProbeForcedRoundHp(node, out _, out _))
+            {
+                pending.Add(node); indices.Add(index);
+                unique &= seen.Add((CombatSolver.Engine.InCombat.Simulation.CombatPredictionSimulator)node.Snapshot.Simulator);
+            }
+        }
+        if (pending.Count >= 2 && unique)
+        {
+            _forcedRoundParallelWaves++; _forcedRoundParallelNodes += pending.Count;
+            bool[] results = executor.EvaluateForcedRoundHpProbes(pending, maximumStrategicHpDeficit);
+            for (int index = 0; index < pending.Count; index++) prune[indices[index]] = results[index];
+        }
+        else
+            for (int index = 0; index < pending.Count; index++)
+                prune[indices[index]] = ShouldPruneForcedRoundHp(pending[index], maximumStrategicHpDeficit);
+        List<SearchNode>? bounded = null;
+        for (int index = 0; index < retained.Count; index++)
+        {
+            if (!prune[index]) { bounded?.Add(retained[index]); continue; }
+            if (bounded is null)
+            {
+                bounded = new(retained.Count);
+                if (index > 0) bounded.AddRange(retained.GetRange(0, index));
+            }
+            if (smartEligibility) _smartPotionEligibilityBranchesPruned++;
+            else _run.PrimaryIncumbentBranchesPruned++;
+        }
+        return bounded ?? retained;
+    }
+
+    internal void VerifyForcedRoundParallelForTesting(SearchNode template, bool shouldKeep)
+    {
+        List<SearchNode> nodes = [];
+        using var executor = new ParallelExpansionExecutor(this, 16);
+        try
+        {
+            for (int index = 0; index < 16; index++)
+            {
+                var child = template.Snapshot.Simulator.Fork();
+                var snapshot = Snapshot(child, template.Turn, template.ActionCount,
+                    template.Snapshot.ShufflesCrossed, template.BoundaryReason,
+                    ((ForkableSet<uint>)template.Snapshot.ProcessedEnemyDeaths).Fork());
+                nodes.Add(new SearchNode(template.Action, template.ActionCount, template.PotionCount,
+                    template.PotionStrategicCost, template.Turn, template.Traits, template.FutureSoldHp,
+                    snapshot.Score, snapshot.StateKey, snapshot.HasRisk, snapshot.BoundaryReason,
+                    template.IsTerminal, template.Parent, snapshot, template.CombatProgress));
+            }
+            _run.ActiveParallelExpansion = executor;
+            var retained = ApplyZeroCreditForcedRoundHpBound(nodes);
+            if (retained.Count != (shouldKeep ? 16 : 0) || _forcedRoundParallelWaves != 1
+                || _forcedRoundParallelNodes != 16 || _forcedRoundHpProbes != 16
+                || _forcedRoundHpPruned != (shouldKeep ? 0 : 16)
+                || _forcedRoundHpSaved != (shouldKeep ? 16 : 0))
+                throw new InvalidOperationException("Actual independent sixteen-lane forced round proof differs.");
+            if (shouldKeep && nodes.Any(node => !node.Snapshot.HasPrecomputedEndTurnForTesting))
+                throw new InvalidOperationException("Parallel surviving branches did not retain their own single-use result.");
+        }
+        finally
+        {
+            _run.ActiveParallelExpansion = null;
+            foreach (var node in nodes) node.Snapshot.ReleaseSimulator();
+        }
+        if (nodes.Any(node => node.Snapshot.HasPrecomputedEndTurnForTesting))
+            throw new InvalidOperationException("Untaken parallel forward result survived parent release.");
+    }
+
+    private sealed partial class ParallelExpansionExecutor
+    {
+        private int _activeForcedRoundHpWorkers;
+
+        public bool[] EvaluateForcedRoundHpProbes(
+            IReadOnlyList<SearchNode> nodes, int maximumStrategicHpDeficit)
+        {
+            ObjectDisposedException.ThrowIf(_disposed, this);
+            ExpansionLane[] lanes = EnsureBackgroundLanes();
+            using ForcedRoundHpJobWave wave = new(DegreeOfParallelism);
+            bool[] evaluations = new bool[nodes.Count];
+            long startedAt = Stopwatch.GetTimestamp();
+            int next = 0;
+            int active = 0;
+            ExceptionDispatchInfo? firstError = null;
+
+            void Dispatch(int lane)
+            {
+                _coordinator.SearchCancellationToken.ThrowIfCancellationRequested();
+                ForcedRoundHpJob job = new(nodes[next], next, lane, wave, maximumStrategicHpDeficit);
+                wave.Completed.AddCount();
+                try { lanes[lane].Dispatch(job); }
+                catch
+                {
+                    wave.Completed.Signal();
+                    throw;
+                }
+                next++;
+                active++;
+            }
+
+            try
+            {
+                for (int lane = 0; lane < DegreeOfParallelism && next < nodes.Count; lane++)
+                    Dispatch(lane);
+                while (active > 0)
+                {
+                    ForcedRoundHpJobOutcome outcome = wave.Take();
+                    active--;
+                    _workProfile.Record(ParallelExpansionWorkProfile.Kind.ForcedRoundHp,
+                        outcome.ElapsedTicks, outcome.Concurrency);
+                    firstError ??= outcome.Error;
+                    if (firstError != null)
+                        continue;
+                    _coordinator.MergeExpansionWorker(outcome.Worker, outcome.AllocatedBytes);
+                    evaluations[outcome.Job.Index] = outcome.Evaluation;
+                    if (next < nodes.Count)
+                        Dispatch(outcome.Job.Lane);
+                }
+                firstError?.Throw();
+                return evaluations;
+            }
+            finally
+            {
+                // Prune already owns these live candidate roots. No new expansion is admitted,
+                // and no checkpoint may release them until all probe lanes have completed.
+                wave.Completed.Signal();
+                wave.Completed.Wait();
+                while (wave.TryTake(out ForcedRoundHpJobOutcome? pending))
+                {
+                    if (pending!.Error != null)
+                        continue;
+                    _coordinator.MergeExpansionWorker(pending.Worker, pending.AllocatedBytes);
+                }
+                _workProfile.Record(ParallelExpansionWorkProfile.Kind.ForcedRoundHpWave,
+                    Stopwatch.GetTimestamp() - startedAt);
+            }
+        }
+
+        private sealed class ForcedRoundHpJobWave(int capacity) : IDisposable
+        {
+            private readonly object _gate = new();
+            private readonly Queue<ForcedRoundHpJobOutcome> _outcomes = new(capacity);
+            public CountdownEvent Completed { get; } = new(1);
+
+            public void Publish(ForcedRoundHpJobOutcome outcome)
+            {
+                lock (_gate)
+                {
+                    _outcomes.Enqueue(outcome);
+                    Monitor.Pulse(_gate);
+                }
+            }
+
+            public ForcedRoundHpJobOutcome Take()
+            {
+                lock (_gate)
+                {
+                    while (_outcomes.Count == 0)
+                        Monitor.Wait(_gate);
+                    return _outcomes.Dequeue();
+                }
+            }
+
+            public bool TryTake(out ForcedRoundHpJobOutcome? outcome)
+            {
+                lock (_gate)
+                    return _outcomes.TryDequeue(out outcome);
+            }
+
+            public void Dispose() => Completed.Dispose();
+        }
+
+        private sealed class ForcedRoundHpJobOutcome(ForcedRoundHpJob job, CombatBeamSolver worker)
+        {
+            public ForcedRoundHpJob Job { get; } = job;
+            public CombatBeamSolver Worker { get; } = worker;
+            public bool Evaluation;
+            public ExceptionDispatchInfo? Error;
+            public long AllocatedBytes;
+            public long ElapsedTicks;
+            public int Concurrency;
+        }
+
+        private sealed record ForcedRoundHpJob(SearchNode Node, int Index, int Lane, ForcedRoundHpJobWave Wave, int MaximumStrategicHpDeficit)
+            : IExpansionLaneWorkItem
+        {
+            public void Execute(ParallelExpansionExecutor owner, CombatBeamSolver worker)
+            {
+                ForcedRoundHpJobOutcome outcome = new(this, worker);
+                long allocatedAtStart = GC.GetAllocatedBytesForCurrentThread();
+                long startedAt = Stopwatch.GetTimestamp();
+                outcome.Concurrency = Interlocked.Increment(ref owner._activeForcedRoundHpWorkers);
+                try
+                {
+                    worker.SearchCancellationToken.ThrowIfCancellationRequested();
+                    // First representatives have distinct immutable state keys and snapshots.
+                    // No other expansion/probe job can fork this same candidate simultaneously.
+                    outcome.Evaluation = worker.ShouldPruneForcedRoundHp(Node, MaximumStrategicHpDeficit);
+                }
+                catch (System.Exception error)
+                {
+                    outcome.Error = ExceptionDispatchInfo.Capture(error);
+                }
