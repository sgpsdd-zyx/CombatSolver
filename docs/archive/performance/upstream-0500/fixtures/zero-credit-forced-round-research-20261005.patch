+            throw new InvalidOperationException("Completed owned EndTurn invalidated adaptive capture fallback.");
+        MergeExpansionWorker(worker, 0);
+        return result;
+    }
+    internal bool ForcedRoundKeptForTesting(SearchNode node) => ApplyZeroCreditForcedRoundHpBound([node]).Count != 0;
