+internal sealed partial class CombatBeamSolver
+{
+    internal sealed record HuntClosedTierProof(string Evidence, string NativeCheapPotionState);
+
+    internal static HuntClosedTierProof HuntClosedTierProbeForTesting(CombatRootSnapshot root,
+        SolverDisplayNames names, BattleDamageSnapshot damage, SearchPolicySnapshot policy)
+    {
+        using var isolation = SimulationNotificationIsolation.Enter();
+        using var deadline = new CancellationTokenSource(TimeSpan.FromSeconds(25));
+        SolverResult counterfactual = new CombatBeamSolver(root, names, damage, policy, deadline.Token,
+            searchProfile: policy.Profile with { MaxExpandedNodes = 1 },
+            potionPolicyOverride: SolverPotionPolicy.Disabled).Solve();
+        if (counterfactual.Snapshot.AllEnemiesDead) throw new InvalidOperationException("Expected incomplete counterfactual.");
+        PotionFreePolicyBaseline baseline = new(false, counterfactual.ProjectedBattleHpLost,
+            counterfactual.Snapshot.PlayerHp, counterfactual.CombatEndedTurn);
+        CombatBeamSolver Member(PrimaryIncumbentTable table, int maximum = 1, bool disabled = false)
+            => new(root, names, damage, policy with { PrimaryIncumbents = table,
+                DisableSharedPrimaryIncumbentsForTesting = disabled }, deadline.Token,
+                potionPolicyOverride: SolverPotionPolicy.RequireAtLeastOne, potionFreePolicyBaseline: baseline,
+                maximumPotionUses: maximum, minimumPotionUses: 1);
+        SearchNode PotionPrefix(CombatBeamSolver member, int slot)
+        {
+            SearchNode seed = CreateOpeningSearchSeed(member.Replay([]));
+            PlanAction action = member.PreparePotionActions(seed).First(a => a.Action.PotionSlot == slot).Action;
+            return member.CostChildForTesting(seed, action);
+        }
+        SearchNode Winner(CombatBeamSolver member, SearchNode node)
+        {
+            foreach ((string card, int enemy) in new[] { ("THE_HUNT", 0), ("STRIKE_SILENT", 1),
+                ("STRIKE_SILENT", 1), ("STRIKE_SILENT", 1) })
+            {
+                PlanAction action = member.PrepareCardActions(node).First(a => a.Action.CardId == card
+                    && a.Action.TargetCombatId == root.Enemies[enemy].CombatId).Action;
+                node = member.CostChildForTesting(node, action);
+            }
+            if (!node.IsTerminal || node.Snapshot.HasRisk || node.Snapshot.GrowthRewards.TheHunt != 1)
+                throw new InvalidOperationException("Expected actual complete unsatisfied growth1 victory.");
+            return node;
+        }
+        var table = new PrimaryIncumbentTable(); var member = Member(table);
+        var expensive = PotionPrefix(member, 0); var cheap = PotionPrefix(member, 1);
+        var expensiveWinner = Winner(member, expensive); var cheapWinner = Winner(member, cheap);
+        int expensiveCost = expensive.Snapshot.ExplicitPotionStrategicCost;
+        int cheapCost = cheap.Snapshot.ExplicitPotionStrategicCost;
+        if (expensiveCost <= cheapCost || !member.TightenPrimarySearchIncumbentAtTurnLayer([expensiveWinner], 0))
+            throw new InvalidOperationException("Actual paid victory/cost did not publish existing witness.");
+        int hpBound = 1;
+        if (!table.HasStrictZeroGrowthHpWitness(policy, 0, 1, hpBound, expensiveCost)
+            || table.HasStrictZeroGrowthHpWitness(policy, 0, 1, hpBound, cheapCost)
+            || table.HasStrictZeroGrowthHpWitness(policy, 0, 1, 0, expensiveCost)
+            || table.HasStrictZeroGrowthHpWitness(policy, 0, 0, hpBound, expensiveCost)
+            || table.HasStrictZeroGrowthHpWitness(policy with { GrowthBudgets = new(TheHunt: 1) }, 0, 1, hpBound, expensiveCost)
+            || table.HasStrictZeroGrowthHpWitness(policy with { RelicTargets = [new(RelicCounterId.PenNib, 2, 2, 0, 10)] }, 0, 1, hpBound, expensiveCost)
+            || table.HasStrictZeroGrowthHpWitness(policy with { TheftPolicy = SolverTheftPolicy.PreserveResources }, 0, 1, hpBound, expensiveCost)
+            || table.HasStrictZeroGrowthHpWitness(policy with { PotionStrategy = new(SolverPotionPolicy.Smart,
+                [new(0, "CURE_ALL", SolverPotionDirective.Force)]) }, 0, 1, hpBound, expensiveCost))
+            throw new InvalidOperationException("Closed tier strict HP/cost/policy guard differs.");
+        var damaged = member.CostChildForTesting(expensive, new(PlanActionKind.EndTurn, expensive.Turn));
+        var cheapDamaged = member.CostChildForTesting(cheap, new(PlanActionKind.EndTurn, cheap.Turn));
+        for (int i = 0; i < 8 && cheapDamaged.Snapshot.CumulativePlayerHpLost == 0; i++)
+            cheapDamaged = member.CostChildForTesting(cheapDamaged, new(PlanActionKind.EndTurn, cheapDamaged.Turn));
+        int openCount = Member(table, maximum: 2).ApplyPrimaryIncumbentBound([damaged]).Count;
+        int ablatedCount = Member(table, disabled: true).ApplyPrimaryIncumbentBound([damaged]).Count;
+        int cheapCount = member.ApplyPrimaryIncumbentBound([cheapDamaged]).Count;
+        int equalCount = member.ApplyPrimaryIncumbentBound([expensive]).Count;
+        int damagedCount = member.ApplyPrimaryIncumbentBound([damaged]).Count;
+        if (damaged.Snapshot.CumulativePlayerHpLost <= 0 || cheapDamaged.Snapshot.CumulativePlayerHpLost <= 0
+            || openCount != 1 || ablatedCount != 1 || cheapCount != 1
+            || equalCount != 1 || damagedCount != 0
+            || member._run.ZeroGrowthStrictPrimaryPrunes == 0)
+            throw new InvalidOperationException($"Actual closed/open tier or cheaper/equal HP route differs: "
+                + $"hp={damaged.Snapshot.CumulativePlayerHpLost}/{cheapDamaged.Snapshot.CumulativePlayerHpLost} "
+                + $"open={openCount} ablated={ablatedCount} cheap={cheapCount} equal={equalCount} "
+                + $"damaged={damagedCount} prunes={member._run.ZeroGrowthStrictPrimaryPrunes}.");
+        var missingTable = new PrimaryIncumbentTable();
+        if (!table.TryGet(ResourceIncumbentPolicy.CompletedBucket(expensiveWinner.Snapshot, 1), out var witness))
+            throw new InvalidOperationException("Actual witness missing.");
+        missingTable.Tighten(ResourceIncumbentPolicy.CompletedBucket(expensiveWinner.Snapshot, 1),
+            witness with { ExplicitPotionStrategicCost = null });
+        if (Member(missingTable).ApplyPrimaryIncumbentBound([damaged]).Count != 1)
+            throw new InvalidOperationException("Missing actual potion cost pruned route.");
+        var unknown = ((CombatPredictionSimulator)damaged.Snapshot.Simulator).Fork();
+        unknown.AddToCombat<Feed>(root.PlayerIdentity.Creature, PileType.Exhaust, 1, creator: null);
+        var unknownSnapshot = member.Snapshot(unknown, damaged.Turn, damaged.ActionCount,
+            damaged.Snapshot.ShufflesCrossed, SearchBoundaryReason.None,
+            ((ForkableSet<uint>)damaged.Snapshot.ProcessedEnemyDeaths).Fork());
+        var unknownNode = new SearchNode(damaged.Action, damaged.ActionCount, damaged.PotionCount,
+            damaged.PotionStrategicCost, damaged.Turn, damaged.Traits, damaged.FutureSoldHp, unknownSnapshot.Score,
+            unknownSnapshot.StateKey, unknownSnapshot.HasRisk, unknownSnapshot.BoundaryReason, false,
+            damaged.Parent, unknownSnapshot, damaged.CombatProgress);
+        if (member.ApplyPrimaryIncumbentBound([unknownNode]).Count != 1)
+            throw new InvalidOperationException("Unknown exhausted Feed escaped closed tier proof.");
+        var control = Member(new(), disabled: true).Solve(); var candidate = Member(new()).Solve();
+        static string Quality(SolverResult r) => $"won={r.Snapshot.AllEnemiesDead},hp={r.ProjectedBattleHpLost},"
+            + $"growth={r.Snapshot.GrowthRewards.TheHunt},pots={r.ExplicitPotionCount},"
+            + $"cost={r.PotionStrategicCostByTurn.Values.Sum()},expanded={r.TotalExpandedNodes},transitions={r.TotalTransitionCount}";
+        if (!control.Snapshot.AllEnemiesDead || !candidate.Snapshot.AllEnemiesDead
+            || candidate.Snapshot.PlayerDead || candidate.Snapshot.HasRisk
+            || candidate.BoundaryReason != SearchBoundaryReason.None
+            || candidate.ProjectedBattleHpLost > control.ProjectedBattleHpLost
+            || candidate.ProjectedBattleHpLost == control.ProjectedBattleHpLost
+                && candidate.Snapshot.GrowthRewards.TheHunt < control.Snapshot.GrowthRewards.TheHunt
+            || candidate.ExplicitPotionCount != 1 || candidate.Snapshot.ProjectedDeathSaveUseCount != 0
+            || candidate.PotionStrategicCostByTurn.Values.Sum() > control.PotionStrategicCostByTurn.Values.Sum())
+            throw new InvalidOperationException($"Closed-tier same-budget quality differs: control=[{Quality(control)}] candidate=[{Quality(candidate)}].");
+        string nativeState = ContinuationStamp.CapturePredicted(root.PlayerIdentity, cheap.Snapshot.Simulator,
+            root.StartTurnNumber, root.Forecast, root.StartTurnNumber).StateText;
+        return new($"ClosedTierHunt:costs={expensiveCost}/{cheapCost}:strictPrunes={member._run.ZeroGrowthStrictPrimaryPrunes}:"
+            + $"control=[{Quality(control)}]:candidate=[{Quality(candidate)}]", nativeState);
+    }
+}
