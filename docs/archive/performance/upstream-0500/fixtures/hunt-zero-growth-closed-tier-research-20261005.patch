+internal sealed partial class CombatBeamSolver
+{
+    internal sealed record HuntRecoveryProof(CombatBeamSolver Member, string QualityEvidence)
+    {
+        internal void AdvanceForNativeComparison(CombatPredictionSimulator simulator, int startingTurn)
+            => Member.AdvanceHuntRoundForTesting(simulator, startingTurn);
+    }
+
+    private void AdvanceHuntRoundForTesting(CombatPredictionSimulator simulator, int startingTurn)
+    {
+        int shuffles = 0;
+        HashSet<uint> deaths = [];
+        foreach (var enemy in root.Enemies)
+            if (enemy.CombatId is uint id && simulator.State.GetCreature(enemy).IsDead) deaths.Add(id);
+        var combat = (SimulatedCombatState)simulator.State.CombatState;
+        SearchBoundaryReason boundary = AdvanceRound(simulator, combat, startingTurn, deaths,
+            ref shuffles, turnStartChoices: null);
+        if (boundary != SearchBoundaryReason.None || combat.GetPlayerTurnNumber(_player) != startingTurn + 1)
+            throw new InvalidOperationException("Native Hunt turn comparison reached a boundary.");
+    }
+
+    internal static HuntRecoveryProof HuntRecoveryProbeForTesting(CombatRootSnapshot root,
+        SolverDisplayNames names, BattleDamageSnapshot damage, SearchPolicySnapshot policy)
+    {
+        using var isolation = SimulationNotificationIsolation.Enter();
+        using var deadline = new CancellationTokenSource(TimeSpan.FromSeconds(25));
+        CombatBeamSolver Member(PrimaryIncumbentTable table) => new(root, names, damage,
+            policy with { PrimaryIncumbents = table }, deadline.Token);
+        SearchNode Route(CombatBeamSolver member, bool satisfied)
+        {
+            SearchNode node = CreateOpeningSearchSeed(member.Replay([]));
+            SearchNode Play(string card, int enemy)
+            {
+                var action = member.PrepareCardActions(node).First(a => a.Action.CardId == card
+                    && a.Action.TargetCombatId == root.Enemies[enemy].CombatId).Action;
+                node = member.CostChildForTesting(node, action); return node;
+            }
+            Play("THE_HUNT", 0);
+            Play("STRIKE_SILENT", 1);
+            if (satisfied) Play("THE_HUNT", 1);
+            else { Play("STRIKE_SILENT", 1); Play("STRIKE_SILENT", 1); }
+            if (!node.IsTerminal || node.Snapshot.HasRisk || node.Snapshot.PlayerDead
+                || node.Snapshot.GrowthRewards.TheHunt != (satisfied ? 2 : 1))
+                throw new InvalidOperationException("Actual Hunt victory did not establish expected growth.");
+            return node;
+        }
+        var table = new PrimaryIncumbentTable(); var member = Member(table);
+        SearchNode unsatisfied = Route(member, false);
+        member.TightenPrimarySearchIncumbentAtTurnLayer([unsatisfied], 0);
+        if (!table.HasStrictZeroGrowthHpWitness(policy, 0, 0, 1)
+            || table.HasStrictZeroGrowthHpWitness(policy, 0, 0, 0))
+            throw new InvalidOperationException("Strict HP comparison changed for an unsatisfied zero-price growth victory.");
+        SearchNode satisfied = Route(member, true);
+        member.TightenPrimarySearchIncumbentAtTurnLayer([satisfied], 0);
+        if (!table.HasStrictZeroGrowthHpWitness(policy, 0, 0, 1)
+            || table.HasStrictZeroGrowthHpWitness(policy, 0, 0, 0)
+            || table.HasStrictZeroGrowthHpWitness(policy with { GrowthBudgets = new(TheHunt: 1) }, 0, 0, 1)
+            || table.HasStrictZeroGrowthHpWitness(policy with { RelicTargets = [new(RelicCounterId.PenNib, 2, 2, 0, 10)] }, 0, 0, 1)
+            || table.HasStrictZeroGrowthHpWitness(policy with { TheftPolicy = SolverTheftPolicy.PreserveResources }, 0, 0, 1)
+            || table.HasStrictZeroGrowthHpWitness(policy with { PotionPolicy = SolverPotionPolicy.RequireAtLeastOne }, 0, 0, 1)
+            || !table.HasStrictZeroGrowthHpWitness(policy with { GrowthOpportunityTargets = GrowthOpportunityTargets.UnboundedForTesting("hunt_bound") }, 0, 0, 1)
+            || table.HasStrictZeroGrowthHpWitness(policy with { PotionStrategy = new(SolverPotionPolicy.Smart,
+                [new(0, "ENERGY_POTION", SolverPotionDirective.Force)]) }, 0, 0, 1)
+            || table.HasStrictZeroGrowthHpWitness(policy, 0, 1, 1))
+            throw new InvalidOperationException("Strict zero-growth witness policy/equal-HP guard differs.");
+        SearchNode seed = CreateOpeningSearchSeed(member.Replay([]));
+        SearchNode damaged = member.CostChildForTesting(seed, new(PlanActionKind.EndTurn, seed.Turn));
+        if (damaged.Snapshot.CumulativePlayerHpLost <= satisfied.Snapshot.CumulativePlayerHpLost
+            || member.ApplyPrimaryIncumbentBound([damaged]).Count != 0
+            || member._run.ZeroGrowthStrictPrimaryPrunes == 0)
+            throw new InvalidOperationException("Actual damaged incomplete growth route was not strictly bounded.");
+        var empty = Member(new());
+        if (empty.ApplyPrimaryIncumbentBound([damaged]).Count != 1)
+            throw new InvalidOperationException("Missing complete witness pruned a route.");
+        var unknown = ((CombatPredictionSimulator)damaged.Snapshot.Simulator).Fork();
+        unknown.AddToCombat<Feed>(root.PlayerIdentity.Creature, PileType.Exhaust, 1, creator: null);
+        var unknownSnapshot = member.Snapshot(unknown, damaged.Turn, damaged.ActionCount,
+            damaged.Snapshot.ShufflesCrossed, SearchBoundaryReason.None,
+            ((ForkableSet<uint>)damaged.Snapshot.ProcessedEnemyDeaths).Fork());
+        var unknownNode = new SearchNode(damaged.Action, damaged.ActionCount, damaged.PotionCount,
+            damaged.PotionStrategicCost, damaged.Turn, damaged.Traits, damaged.FutureSoldHp, unknownSnapshot.Score,
+            unknownSnapshot.StateKey, unknownSnapshot.HasRisk, unknownSnapshot.BoundaryReason, false,
+            damaged.Parent, unknownSnapshot, damaged.CombatProgress);
+        if (member.ApplyPrimaryIncumbentBound([unknownNode]).Count != 1)
+            throw new InvalidOperationException("Unknown exhausted healing escaped strict-growth guard.");
+        var control = new CombatBeamSolver(root, names, damage,
+            policy with { DisableSharedPrimaryIncumbentsForTesting = true }, deadline.Token).Solve();
+        var result = Member(new()).Solve();
+        static string Quality(SolverResult value) => $"won={value.Snapshot.AllEnemiesDead} "
+            + $"dead={value.Snapshot.PlayerDead} risk={value.Snapshot.HasRisk} boundary={value.BoundaryReason} "
+            + $"hp={value.ProjectedBattleHpLost} hunt={value.Snapshot.GrowthRewards.TheHunt} "
+            + $"pots={value.ExplicitPotionCount} deathsave={value.Snapshot.ProjectedDeathSaveUseCount} "
+            + $"expanded={value.TotalExpandedNodes} transitions={value.TotalTransitionCount}";
+        Godot.GD.Print($"[CombatSolver] HUNT_STRICT_QUALITY control=[{Quality(control)}] candidate=[{Quality(result)}]");
+        if (!control.Snapshot.AllEnemiesDead || control.Snapshot.PlayerDead || control.Snapshot.HasRisk
+            || control.BoundaryReason != SearchBoundaryReason.None
+            || !result.Snapshot.AllEnemiesDead || result.Snapshot.PlayerDead || result.Snapshot.HasRisk
+            || result.BoundaryReason != SearchBoundaryReason.None
+            || result.ProjectedBattleHpLost > control.ProjectedBattleHpLost
+            || result.ProjectedBattleHpLost == control.ProjectedBattleHpLost
+                && result.Snapshot.GrowthRewards.TheHunt < control.Snapshot.GrowthRewards.TheHunt
+            || result.ExplicitPotionCount != 0 || result.Snapshot.ProjectedDeathSaveUseCount != 0)
+            throw new InvalidOperationException($"DOP2 strict same-budget search changed Hunt quality: "
+                + $"control=[{Quality(control)}] candidate=[{Quality(result)}].");
+        unknownSnapshot.ReleaseSimulator(); damaged.Snapshot.ReleaseSimulator(); seed.Snapshot.ReleaseSimulator();
+        foreach (SearchNode winner in new[] { unsatisfied, satisfied })
+            for (SearchNode? node = winner; node != null; node = node.Parent) node.Snapshot.ReleaseSimulator();
+        return new(member, $"HuntSameBudgetDop2Strict:control=[{Quality(control)}]:candidate=[{Quality(result)}]");
+    }
+}
