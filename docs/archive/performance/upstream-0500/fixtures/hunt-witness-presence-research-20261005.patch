+        static string Quality(SolverResult value) => $"won={value.Snapshot.AllEnemiesDead} "
+            + $"dead={value.Snapshot.PlayerDead} risk={value.Snapshot.HasRisk} boundary={value.BoundaryReason} "
+            + $"hp={value.ProjectedBattleHpLost} hunt={value.Snapshot.GrowthRewards.TheHunt} "
