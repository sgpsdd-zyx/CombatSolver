+    private void AdvanceHuntRoundForTesting(CombatPredictionSimulator simulator, int startingTurn)
+    {
+        int shuffles = 0;
+        HashSet<uint> deaths = [];
+        foreach (var enemy in root.Enemies)
+            if (enemy.CombatId is uint id && simulator.State.GetCreature(enemy).IsDead) deaths.Add(id);
+        var combat = (SimulatedCombatState)simulator.State.CombatState;
+        SearchBoundaryReason boundary = AdvanceRound(simulator, combat, startingTurn, deaths,
+            ref shuffles, turnStartChoices: null);
+        if (boundary != SearchBoundaryReason.None || combat.GetPlayerTurnNumber(_player) != startingTurn + 1)
+            throw new InvalidOperationException("Native Hunt turn comparison reached a boundary.");
+    }
+
