+            || result.ProjectedBattleHpLost > control.ProjectedBattleHpLost
+            || result.ProjectedBattleHpLost == control.ProjectedBattleHpLost
+                && result.Snapshot.GrowthRewards.TheHunt < control.Snapshot.GrowthRewards.TheHunt
+            || result.ExplicitPotionCount != 0 || result.Snapshot.ProjectedDeathSaveUseCount != 0)
+            throw new InvalidOperationException($"DOP2 strict same-budget search changed Hunt quality: "
+                + $"control=[{Quality(control)}] candidate=[{Quality(result)}].");
+        unknownSnapshot.ReleaseSimulator(); damaged.Snapshot.ReleaseSimulator(); seed.Snapshot.ReleaseSimulator();
+        foreach (SearchNode winner in new[] { unsatisfied, satisfied })
+            for (SearchNode? node = winner; node != null; node = node.Parent) node.Snapshot.ReleaseSimulator();
+        return new(member, $"HuntSameBudgetDop2Strict:control=[{Quality(control)}]:candidate=[{Quality(result)}]");
+    }
+}
