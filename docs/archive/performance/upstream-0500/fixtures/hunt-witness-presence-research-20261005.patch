+                    && a.Action.TargetCombatId == root.Enemies[enemy].CombatId).Action;
+                node = member.CostChildForTesting(node, action); return node;
+            }
+            Play("THE_HUNT", 0);
+            Play("STRIKE_SILENT", 1);
+            if (satisfied) Play("THE_HUNT", 1);
+            else { Play("STRIKE_SILENT", 1); Play("STRIKE_SILENT", 1); }
+            if (!node.IsTerminal || node.Snapshot.HasRisk || node.Snapshot.PlayerDead
+                || node.Snapshot.GrowthRewards.TheHunt != (satisfied ? 2 : 1))
+                throw new InvalidOperationException("Actual Hunt victory did not establish expected growth.");
+            return node;
+        }
