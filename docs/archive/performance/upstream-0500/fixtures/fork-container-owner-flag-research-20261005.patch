+        var mapGrandchild = mapFork.Fork(); var listGrandchild = listFork.Fork();
+        var setGrandchild = setFork.Fork();
+        map["FIRST"] = 10; map.Add("Third", 3);
+        list[0] = 10; list.Add(4);
+        set.Add("Third"); set.Remove("First");
