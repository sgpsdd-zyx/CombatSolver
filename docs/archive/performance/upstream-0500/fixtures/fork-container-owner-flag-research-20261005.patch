+        var children = Enumerable.Range(0, 16).Select(_ =>
+            (Map: rootMap.Fork(), List: rootList.Fork(), Set: rootSet.Fork())).ToArray();
+        // All children exist before parallel branch mutation, matching the engine ownership boundary.
+        await Task.WhenAll(children.Select((child, index) => Task.Run(() =>
+        {
+            child.Map["SEED"] = index + 10; child.Map.Add("child", index);
+            child.List[0] = index + 10; child.List.Add(index);
+            child.Set.Remove("SEED"); child.Set.Add(index.ToString());
+            var descendantMap = child.Map.Fork(); var descendantList = child.List.Fork();
+            var descendantSet = child.Set.Fork();
