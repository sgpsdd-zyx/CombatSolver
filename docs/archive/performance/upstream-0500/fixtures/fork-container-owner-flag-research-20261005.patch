+        var observedList = new List<int>();
+        while (listEnumerator.MoveNext()) observedList.Add(listEnumerator.Current);
+        var observedSet = new List<string>();
+        while (setEnumerator.MoveNext()) observedSet.Add(setEnumerator.Current);
+        if (!observedMap.SequenceEqual(mapGrandchild)
